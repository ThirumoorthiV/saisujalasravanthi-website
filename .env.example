# All values here are public by design (they end up in the browser bundle).
# Copy to .env and fill in. Never put passwords or private keys in this file.

# Web3Forms access key — create one free at https://web3forms.com with the
# inbox that should receive form submissions (email notification).
VITE_WEB3FORMS_ACCESS_KEY=

# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
# Submissions are saved to Firestore (collection: submissions).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key for Firebase App Check (blocks spam bots).
VITE_RECAPTCHA_SITE_KEY=
