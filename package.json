{
  "name": "saisujalasravanthi-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-content.mjs --dev && vite",
    "build": "node scripts/fetch-content.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
